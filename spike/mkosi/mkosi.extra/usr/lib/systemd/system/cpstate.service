[Unit]
Description=Workspace state disk (home, Docker data)
DefaultDependencies=no
After=systemd-udev-trigger.service local-fs-pre.target
Before=local-fs.target cloud-init-local.service cloud-init-main.service systemd-user-sessions.service
Wants=systemd-udev-trigger.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/cpstate-setup

[Install]
WantedBy=local-fs.target
