#!/bin/sh
set -eu
# Every mount in the initrd counts against PID 1's mount-event rate limit (5/s);
# once over it, systemd holds back mount jobs, sysroot.mount included, until the
# 1 s window ends (~0.4 s stall seen). Keep only what the initrd needs.
systemctl mask dev-hugepages.mount dev-mqueue.mount sys-kernel-debug.mount \
	sys-kernel-tracing.mount sys-fs-fuse-connections.mount sys-kernel-config.mount \
	tmp.mount run-lock.mount
# no network in the initrd
systemctl mask systemd-networkd.service systemd-networkd.socket \
	systemd-network-generator.service systemd-networkd-wait-online.service \
	systemd-resolved.service
