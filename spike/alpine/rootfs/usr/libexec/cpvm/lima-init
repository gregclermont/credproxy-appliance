#!/bin/sh
# spike/mkosi's lima-init for OpenRC (no systemd: no guest agent unit, no
# linger): the user, its key and the cidata mount. Lima's boot.sh runs from
# the lima-boot service (the `lima` variant), not here.
#
# Without it there is no sshd, which the host would only see as a timeout:
# a failure ends in a kernel panic after a "cpvm: FATAL" line. A shared
# folder that does not mount stays a warning.
set -eu
mnt=/mnt/lima-cidata

fatal() {
	trap - EXIT
	echo "cpvm: FATAL: lima-init: $*" >/dev/console
	echo 1 >/proc/sys/kernel/sysrq
	echo c >/proc/sysrq-trigger
	exit 1
}
trap 'fatal "unexpected exit (status $?)"' EXIT

# disk: the whole disk of block device $1 (a partition's parent, or itself)
disk() {
	b=$(readlink -f "/sys/class/block/$1")
	if [ -e "$b/partition" ]; then b=${b%/*}; fi
	echo "${b##*/}"
}
# cidata: the device Lima's cloud-init volume is on. Never by label alone:
# boot.sh from it runs as root at every boot, and guest root can write a
# filesystem labelled cidata to any writable disk. The host attaches it
# read-only and nothing else is: on QEMU the only CD (virtio-scsi), on VZ a
# virtio disk after the image and state disks. So: whole disks the kernel
# sees as read-only, neither the disk under the verity root nor the state
# disk, holding iso9660 labelled cidata; exactly one, or no cidata at all.
cidata() {
	skip=
	for s in /sys/block/dm-*/slaves/*; do
		if [ -e "$s" ]; then skip="$skip $(disk "${s##*/}")"; fi
	done
	src=$(awk '$2 == "/var/lib/cpstate" { print $1 }' /proc/mounts)
	[ -z "$src" ] || skip="$skip $(disk "${src#/dev/}")"
	skip=$(echo $skip | tr ' ' '\n' | sort -u | tr '\n' ' ')
	found=
	for b in /sys/block/sr* /sys/block/vd*; do
		[ -e "$b" ] || continue
		d=${b##*/}
		[ "$(cat "$b/ro")" = 1 ] || continue
		case " $skip " in *" $d "*) continue ;; esac
		[ "$(blkid -p -o value -s TYPE "/dev/$d" 2>/dev/null)" = iso9660 ] || continue
		[ "$(blkid -p -o value -s LABEL "/dev/$d" 2>/dev/null)" = cidata ] || continue
		found="$found /dev/$d"
	done
	# shellcheck disable=SC2086 # device names, split on purpose
	set -- $found
	[ $# = 1 ] || fatal "refusing cidata: want one read-only iso9660 disk labelled cidata, found: ${found:-none} (image/state disks: ${skip:-none})"
	echo "$1"
}

mkdir -p -m 700 "$mnt"
if ! mountpoint -q "$mnt"; then
	dev=$(cidata)
	echo "lima-init: cidata on $dev" >&2
	mount -t iso9660 -o ro,mode=0700,dmode=0700,overriderockperm,exec,uid=0 "$dev" "$mnt"
fi
ud=$mnt/user-data
# shellcheck disable=SC2163
while read -r line; do [ -n "$line" ] && export "$line"; done <"$mnt/lima.env"

h=$(sed -n 's/^local-hostname: *//p' "$mnt/meta-data")
[ -z "$h" ] || { echo "$h" >/etc/hostname; hostname "$h"; }
tz=$(sed -n 's/^timezone: *//p' "$ud")
[ -z "$tz" ] || [ ! -e "/usr/share/zoneinfo/$tz" ] || ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime

u=$LIMA_CIDATA_USER home=$LIMA_CIDATA_HOME
if ! id "$u" >/dev/null 2>&1; then
	m=-m
	[ ! -d "$home" ] || m=-M
	useradd -u "$LIMA_CIDATA_UID" -c "$LIMA_CIDATA_COMMENT" -d "$home" -s "$LIMA_CIDATA_SHELL" $m "$u"
fi
# sshd without PAM refuses locked accounts ("!"): no password, but not locked
usermod -p '*' -aG docker "$u"
if [ "$LIMA_CIDATA_PASSWORDLESS_SUDO" = 1 ]; then
	echo "$u ALL=(ALL) NOPASSWD:ALL" >/etc/sudoers.d/90-lima-users
else
	echo "$u ALL=(ALL) ALL" >/etc/sudoers.d/90-lima-users
fi
# The home is on the state disk, which the user writes: ~/.ssh and the key
# file are written as the user, so a link planted there leads nowhere the
# user could not write anyway.
sed -n '/^ *ssh[-_]authorized[-_]keys:/,/^ *[^ -]/{s/^ *- *"\(.*\)"$/\1/p}' "$ud" |
	su -s /bin/sh "$u" -c 'set -e; umask 077; cd
		if [ -L .ssh ] || { [ -e .ssh ] && [ ! -d .ssh ]; }; then rm -f .ssh; fi
		mkdir -p .ssh; chmod 700 .ssh
		t=$(mktemp .ssh/.authorized_keys.XXXXXX); cat >"$t"; mv -f "$t" .ssh/authorized_keys' ||
	fatal "writing $u's authorized_keys"

tab=$(printf '\t')
sed -n '/^mounts:/,/^[^ -]/{s/^- *\[\(.*\)\]$/\1/p}' "$ud" | tr -d '"' | sed "s/, /$tab/g" |
	while IFS=$tab read -r tag mp type opts _; do
		mkdir -p "$mp"
		mountpoint -q "$mp" || mount -t "$type" -o "$opts" "$tag" "$mp" || echo "lima-init: mount $tag on $mp failed" >&2
	done

etcenv=/etc/environment
[ ! -e "$etcenv" ] || sed -i '/#LIMA-START/,/#LIMA-END/d' "$etcenv"
cat "$mnt/etc_environment" >>"$etcenv"
: >/run/credproxy-ssh-stable
echo "$LIMA_CIDATA_IID" >/run/lima-ssh-ready
trap - EXIT
