#!/sbin/openrc-run
# As the mkosi image's lima-modules.service: the modules Lima's boot scripts
# and dockerd load, early and off the critical path.
description="Kernel modules Lima's boot scripts and dockerd load"
start() {
	(modprobe -a fuse tun tap bridge veth ip_tables ip6_tables iptable_nat ip6table_nat iptable_filter \
		ip6table_filter nf_tables x_tables xt_MASQUERADE xt_addrtype xt_comment xt_conntrack xt_mark \
		xt_multiport xt_nat xt_tcpudp overlay br_netfilter 2>/dev/null &)
}
